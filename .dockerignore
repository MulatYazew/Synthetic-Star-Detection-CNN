.git
.gitattributes
__pycache__/
*.pyc
.venv
venv
.streamlit/secrets.toml

# Notebooks — not used by the Streamlit demo, and carry ~6.7MB of saved
# cell outputs.
notebooks/

# Local dataset (833MB) — already .gitignored, never needed at runtime since
# demo/app.py generates synthetic fields on the fly and only reads real data
# via user-uploaded files, not from this directory.
star-dataset/

# Training artifacts (plots, metrics, cached splits) — not read by the
# Streamlit demo. results/ is ~356MB, figures/ is ~8.7MB.
results/
figures/

# models/*.pt (the 3 trained checkpoints, ~124MB each) are intentionally NOT
# excluded here — demo/app.py loads them at runtime and they're baked into
# the image via Git LFS during Render's build. See Dockerfile.

.DS_Store
.claude/
